[Unit]
Description=iCloud Calendar Private API
After=network.target

[Service]
Type=simple
User=icloudcalendarapi
Group=icloudcalendarapi
WorkingDirectory=/var/lib/icloudcalendarapi
ExecStart=/usr/bin/icloud-calendar-private-api
Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/icloudcalendarapi
ReadOnlyPaths=/etc/icloudcalendarapi

[Install]
WantedBy=multi-user.target
